# Copy this file to .env and edit the values.

# Port the server listens on
PORT=3000

# Key required to view /admin.html and hit /api/admin/* endpoints
# CHANGE THIS before deploying.
ADMIN_KEY=replace-with-a-long-random-secret

# ---- Optional email notifications on new inquiries ----
# Leave EMAIL_ENABLED=false to skip email entirely (default, zero setup).
# To enable: run `npm install nodemailer`, set EMAIL_ENABLED=true, and fill in SMTP details.
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=studio@sterlyn.com
NOTIFY_TO=studio@sterlyn.com
